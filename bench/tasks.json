     "steps": [{"intent": "click the Next page link", "value": null},
               {"intent": "read the first quote and its author", "value": null}],
     "check": {"url_regex": "/page/2/?$", "extracted_regex": "[“\"].{10,}"}},
    {"id": "books-travel", "url": "https://books.toscrape.com/",
     "steps": [{"intent": "click the Travel category in the sidebar", "value": null},
               {"intent": "read the title and price of the first book", "value": null}],
     "check": {"url_regex": "travel_2", "extracted_regex": "£\\s?\\d"}},
    {"id": "wikipedia-search", "url": "https://en.wikipedia.org/wiki/Main_Page",
     "steps": [{"intent": "type into the search box", "value": "Flutter (software)"},
               {"intent": "press enter to search", "value": null},
               {"intent": "read the first sentence of the article", "value": null}],
     "check": {"url_regex": "Flutter_\\(software\\)", "extracted_regex": "(?i)flutter is"}},
    {"id": "hn-new", "url": "https://news.ycombinator.com/",
     "steps": [{"intent": "click the new link in the top bar", "value": null},
               {"intent": "read the title of the first story", "value": null}],
     "check": {"url_regex": "/newest$", "extracted_regex": "\\w{4,}"}},
    {"id": "pubdev-search", "url": "https://pub.dev/",
     "steps": [{"intent": "type into the package search box", "value": "flutter_on_device_rag"},
               {"intent": "press enter to search", "value": null},
               {"intent": "read the name and description of the first package result", "value": null}],
     "check": {"url_regex": "q=flutter_on_device_rag", "extracted_regex": "flutter_on_device_rag"}},
    {"id": "httpbin-form", "url": "https://httpbin.org/forms/post",
     "steps": [{"intent": "type into the customer name field", "value": "Guru Test"},
               {"intent": "type into the telephone field", "value": "5550100"},
               {"intent": "click the Medium pizza size option", "value": null}],
     "check": {"dom": [["input[name=custname]", "value", "Guru Test"],
                       ["input[name=custtel]", "value", "5550100"],
                       ["input[value=medium]", "checked", true]]}}
  ]
